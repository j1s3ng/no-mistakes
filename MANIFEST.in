include README.md LICENSE AGENTS.md setup.py
recursive-include docs *.md *.json
recursive-include skills/no-mistakes *.md
recursive-include examples *.py *.html
recursive-include evals *.json
recursive-include tests *.py
prune .no-mistakes
prune .venv
prune build
prune dist
global-exclude .env .env.* *.py[cod] .DS_Store
